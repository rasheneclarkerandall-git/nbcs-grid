# Required: Anthropic API key, held server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional: override the model used by the AI concierge (defaults to claude-sonnet-5).
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: Vercel KV (Upstash Redis) for durable lead storage.
# Add the "Vercel KV" integration from the Vercel dashboard on this project and
# it will populate these automatically. Without them, leads are appended to a
# local JSON file for local dev only — NOT durable in a serverless deployment.
KV_REST_API_URL=
KV_REST_API_TOKEN=
